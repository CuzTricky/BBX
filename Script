	textbox(pScan, k .. " keywords (comma separated, '=' = exact name)", table.concat(KW[k], ","), function(t)
		local n = {}
		for w in t:gmatch("[^,]+") do
			w = w:match("^%s*(.-)%s*$"):lower()
			if w ~= "" then n[#n + 1] = w end
		end
