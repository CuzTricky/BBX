---------------------------------------------------------------- log
local logLines, logLabel = {}, nil
local function log(...)
	local parts = {}
	for i, v in ipairs({ ... }) do parts[i] = tostring(v) end
	local s = table.concat(parts, " ")
	logLines[#logLines + 1] = s
	if #logLines > 120 then table.remove(logLines, 1) end
	if logLabel then logLabel.Text = table.concat(logLines, "\n") end
end

---------------------------------------------------------------- helpers
local function getHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot()
	local c = LP.Character
	return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
end

local function hit(name, list)
	name = name:lower()
	for _, k in ipairs(list) do
		if k:sub(1, 1) == "=" then
			if name == k:sub(2) then return true end
		elseif name:find(k, 1, true) then
			return true
		end
	end
	return false
end

local cache = setmetatable({}, { __mode = "k" })
local function clearCache() for k in pairs(cache) do cache[k] = nil end end

local function classify(p)
	local c = cache[p]
	if c ~= nil then return c or nil end
	local kind
	local inst, depth = p, 0
	while inst and inst ~= Workspace and depth < 3 do
		local n = inst.Name
		if hit(n, KW.finish) then kind = "finish" break
		elseif hit(n, KW.hazard) then kind = "hazard" break
		elseif hit(n, KW.orb) then kind = "orb" break
		elseif hit(n, KW.coin) then kind = "coin" break end
		inst = inst.Parent
		depth += 1
	end
	if not kind and S.aggressive then
		local ok, t = pcall(function() return p:FindFirstChildWhichIsA("TouchTransmitter") end)
		if ok and t then kind = "hazard" end
	end
	cache[p] = kind or false
	return kind
end

---------------------------------------------------------------- input
local function mouseSet(down)
	local v = cam().ViewportSize
	if VIM and pcall(function() VIM:SendMouseButtonEvent(v.X * 0.5, v.Y * 0.5, 0, down, game, 0) end) then return end
	pcall(function() if down then mouse1press() else mouse1release() end end)
end
local function keySet(key, down)
	pcall(function() VIM:SendKeyEvent(down, key, false, game) end)
end
local function pressR()
	keySet(Enum.KeyCode.R, true)
	task.wait(0.05)
	keySet(Enum.KeyCode.R, false)
end
local function tap()
	local m = S.method
	if m == "Click" then
		mouseSet(true) task.wait(0.03) mouseSet(false)
	elseif m == "Space" then
		keySet(Enum.KeyCode.Space, true) task.wait(0.03) keySet(Enum.KeyCode.Space, false)
	else
		local h = getHum()
		if h then h.Jump = true pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end) end
	end
end
local function doJump() task.spawn(tap) end

---------------------------------------------------------------- auto jump (bot)
local lastJump = 0
local rpDown = RaycastParams.new()
rpDown.FilterType = Enum.RaycastFilterType.Exclude
local op = OverlapParams.new()
op.FilterType = Enum.RaycastFilterType.Exclude

connect(RunService.Heartbeat, function()
	if not S.autoJump then return end
	local char, root, hum = LP.Character, getRoot(), getHum()
	if not (char and root) then return end
	local now = os.clock()
	if now - lastJump < S.cooldown then return end
	rpDown.FilterDescendantsInstances = { char }
	op.FilterDescendantsInstances = { char }

	local onGround = (hum and hum.FloorMaterial ~= Enum.Material.Air)
		or Workspace:Raycast(root.Position, Vector3.new(0, -5, 0), rpDown) ~= nil
	if not onGround and not S.airJump then return end

	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	local speed = flat.Magnitude
	local dir
	if speed > 3 then
		dir = flat.Unit
	else
		local lv = root.CFrame.LookVector
		dir = Vector3.new(lv.X, 0, lv.Z)
		if dir.Magnitude < 0.01 then return end
		dir = dir.Unit
	end

	local look = math.clamp(speed * S.reaction, S.minLook, S.maxLook)
	local center = root.Position + dir * (look * 0.5 + 2) + Vector3.new(0, 0.5, 0)
	local parts = Workspace:GetPartBoundsInBox(CFrame.lookAt(center, center + dir), Vector3.new(S.boxW, S.boxH, look), op)
	local danger = false
	for _, p in ipairs(parts) do
		if classify(p) == "hazard" and (p.Position.Y + p.Size.Y * 0.5) > root.Position.Y - 2.5 then
			danger = true
			break
		end
	end
	if not danger and S.gapJump and onGround then
		local probe = root.Position + dir * math.max(S.gapLook, speed * 0.15)
		if not Workspace:Raycast(probe, Vector3.new(0, -25, 0), rpDown) then danger = true end
	end
	if danger then
		lastJump = now
		doJump()
	end
end)

