---------------------------------------------------------------- level tools
local function findFinish()
	local root = getRoot()
	if not root then return end
	local best, bd
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BasePart") and classify(d) == "finish" then
			local dist = (d.Position - root.Position).Magnitude
			if not bd or dist < bd then best, bd = d, dist end
		end
	end
	return best
end

local function touchFinish(f)
	local r = getRoot()
	if r and f and firetouchinterest then
		pcall(function() firetouchinterest(r, f, 0) task.wait() firetouchinterest(r, f, 1) end)
	end
end

local function tpFinish()
	local f, r = findFinish(), getRoot()
	if f and r then
		r.CFrame = f.CFrame * CFrame.new(0, f.Size.Y * 0.5 + 3, 0)
		touchFinish(f)
		log("[level] teleported to", f:GetFullName())
	else
		log("[level] no finish part found - check Scan tab keywords")
	end
end

task.spawn(function()
	while alive do
		task.wait(1)
		if S.autoFinish then
			local f = findFinish()
			if f then touchFinish(f) end
		end
	end
end)

