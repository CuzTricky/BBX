connect(RunService.RenderStepped, function()
	if S.fovOn then cam().FieldOfView = S.fov end
	if S.fly then
		local r, h = getRoot(), getHum()
		if not (r and h) then return end
		local lv = cam().CFrame.LookVector
		local md = h.MoveDirection
		local dir = Vector3.zero
		if md.Magnitude > 0 then
			local flat = Vector3.new(lv.X, 0, lv.Z)
			local fwd = flat.Magnitude > 0 and md:Dot(flat.Unit) or 0
			dir = md + Vector3.new(0, lv.Y * math.max(fwd, 0), 0)
		end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
		r.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * S.flySpeed or Vector3.zero
	end
end)

