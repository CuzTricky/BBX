---------------------------------------------------------------- scanners
local function copyLog()
	local ok = pcall(function() setclipboard(table.concat(logLines, "\n")) end)
	log(ok and "[log] copied to clipboard" or "[log] setclipboard not supported")
end

local function scanRemotes()
	log("---- remotes in ReplicatedStorage ----")
	local n = 0
	for _, d in ipairs(RepStorage:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent") then
			n += 1
			log(d.ClassName .. ": " .. d:GetFullName())
		end
	end
	log("total:", n)
end

local function scanParts()
	log("---- level scan ----")
	local touch, kinds = {}, { hazard = 0, orb = 0, finish = 0, coin = 0 }
	for i, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BasePart") then
			local k = classify(d)
			if k then kinds[k] += 1 end
			local ok, t = pcall(function() return d:FindFirstChildWhichIsA("TouchTransmitter") end)
			if ok and t then touch[d.Name] = (touch[d.Name] or 0) + 1 end
		end
		if i % 1500 == 0 then task.wait() end
	end
	log(("classified: hazard=%d orb=%d finish=%d coin=%d"):format(kinds.hazard, kinds.orb, kinds.finish, kinds.coin))
	local arr = {}
	for n, c in pairs(touch) do arr[#arr + 1] = { n, c } end
	table.sort(arr, function(a, b) return a[2] > b[2] end)
	log("parts with TouchInterest (name x count):")
	for i = 1, math.min(#arr, 40) do log("  " .. arr[i][1] .. " x" .. arr[i][2]) end
	local names = {}
	for _, c in ipairs(Workspace:GetChildren()) do
		if not c:IsA("Terrain") and c ~= cam() then names[#names + 1] = c.Name end
	end
	log("Workspace children: " .. table.concat(names, ", "))
	local r = getRoot()
	if r then log("player root:", r:GetFullName()) end
end

local spyHooked = false
local function enableSpy()
	if spyHooked then return true end
	if not (hookmetamethod and getnamecallmethod) then
		log("[spy] hookmetamethod not supported by this executor")
		return false
	end
	local old
	old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
		local m = getnamecallmethod()
		if S.spy and (m == "FireServer" or m == "InvokeServer") then
			local args = { ... }
			task.defer(function()
				local ok, name = pcall(function() return self:GetFullName() end)
				local a = {}
				for i = 1, math.min(#args, 4) do a[i] = tostring(args[i]) end
				log("[spy]", m, ok and name or "?", "(" .. table.concat(a, ", ") .. ")")
			end)
		end
		return old(self, ...)
	end))
	spyHooked = true
	return true
end

