	Size = UDim2.new(1, -118, 1, -6), Position = UDim2.fromOffset(112, 0), BackgroundTransparency = 1,
}, body)

local pages, tabBtns = {}, {}
local function showPage(n)
	for k, p in pairs(pages) do p.Visible = (k == n) end
	for k, b in pairs(tabBtns) do
		b.BackgroundColor3 = (k == n) and THEME.accent or THEME.panel
		b.TextColor3 = (k == n) and Color3.new(0, 0, 0) or THEME.text
	end
end
local function addPage(n)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = THEME.panel, Text = n, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextColor3 = THEME.text, AutoButtonColor = false,
	}, tabsFrame)
	corner(b, 6)
	local p = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
	}, content)
	new("UIListLayout", { Padding = UDim.new(0, 5) }, p)
	new("UIPadding", { PaddingRight = UDim.new(0, 6) }, p)
	pages[n], tabBtns[n] = p, b
	b.MouseButton1Click:Connect(function() showPage(n) end)
	return p
end

local function runCb(cb, ...)
	local args = { ... }
	task.spawn(function()
		local ok, e = pcall(cb, table.unpack(args))
		if not ok then log("[err]", e) end
	end)
end

local function toggle(page, text, default, cb)
	local r = new("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = THEME.panel, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, page)
	corner(r, 6)
	new("TextLabel", {
		Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = text,
		TextColor3 = THEME.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, r)
	local box = new("Frame", { Size = UDim2.fromOffset(34, 16), Position = UDim2.new(1, -44, 0.5, -8), BackgroundColor3 = THEME.off, BorderSizePixel = 0 }, r)
	corner(box, 8)
	local dot = new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, box)
	corner(dot, 6)
	local state = false
	local function set(v)
		state = v
		box.BackgroundColor3 = v and THEME.accent or THEME.off
		dot.Position = v and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
		runCb(cb, v)
	end
	r.MouseButton1Click:Connect(function() set(not state) end)
	if default then set(true) end
	return set
end

local function slider(page, text, min, max, default, step, cb)
	local r = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = THEME.panel, BorderSizePixel = 0 }, page)
	corner(r, 6)
	local l = new("TextLabel", {
		Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(10, 3), BackgroundTransparency = 1,
		TextColor3 = THEME.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	local bar = new("TextButton", {
		Size = UDim2.new(1, -20, 0, 8), Position = UDim2.new(0, 10, 0, 27), BackgroundColor3 = THEME.off,
		BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	}, r)
	corner(bar, 4)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.accent, BorderSizePixel = 0 }, bar)
	corner(fill, 4)
	local dragging = false
	local function setv(v, silent)
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		l.Text = text .. ": " .. tostring(math.floor(v * 1000 + 0.5) / 1000)
		if not silent then pcall(cb, v) end
	end
	local function fromX(x) setv(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(i.Position.X)
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	setv(default, true)
end

local function button(page, text, cb)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = THEME.off, BorderSizePixel = 0, Text = text,
		TextColor3 = THEME.text, Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true,
	}, page)
	corner(b, 6)
	b.MouseButton1Click:Connect(function() runCb(cb) end)
	return b
end

local function textbox(page, text, default, cb)
	local r = new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = THEME.panel, BorderSizePixel = 0 }, page)
	corner(r, 6)
	new("TextLabel", {
		Size = UDim2.new(1, -12, 0, 16), Position = UDim2.fromOffset(10, 3), BackgroundTransparency = 1, Text = text,
		TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	local tb = new("TextBox", {
		Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 22), BackgroundColor3 = THEME.off, BorderSizePixel = 0,
		Text = default, ClearTextOnFocus = false, TextColor3 = THEME.text, Font = Enum.Font.Code, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	corner(tb, 5)
	tb.FocusLost:Connect(function() runCb(cb, tb.Text) end)
end

local function label(page, text)
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = text,
		TextColor3 = THEME.dim, Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	}, page)
end

